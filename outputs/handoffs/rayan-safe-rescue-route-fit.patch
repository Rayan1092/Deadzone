--- /dev/null
+++ b/server/tests/test_safe_route_fit.py
@@ -0,0 +1,83 @@
+"""Large rescue routes may lose redundant vertices, never required wall turns."""
+
+import math
+import sys
+from itertools import pairwise
+from pathlib import Path
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from deadzone.floorplan import FREE
+from deadzone.robot import planning
+from deadzone.robot.exploration import fit_visible_route, line_clear
+from deadzone.robot.robot import Robot, fit_route
+
+
+def winding_corridor():
+    points = [[0.5, 0.5]]
+    trav = np.zeros((100, 12), dtype=bool)
+    for row in range(33):
+        y = row * 3
+        a, b = (0.5, 10.5) if row % 2 == 0 else (10.5, 0.5)
+        if points[-1] != [a, y + 0.5]:
+            points.append([a, y + 0.5])
+        points.append([b, y + 0.5])
+        trav[y, :11] = True
+        if row < 32:
+            trav[y : y + 4, int(b)] = True
+    return points, trav
+
+
+def test_point_cap_cannot_delete_a_required_corridor_bend():
+    points, trav = winding_corridor()
+    assert len(points) > 60
+    assert all(line_clear(trav, a, b, 1) for a, b in pairwise(points))
+    # This winding corridor genuinely needs >60 vertices. Refuse instead of
+    # advertising the former evenly thinned route, which crosses six walls.
+    assert fit_route(points, trav=trav, cell=1) is None
+
+
+def test_redundant_long_route_gets_shorter_without_cutting_obstacles():
+    points = [[0.625 + i * 0.25, 0.625 + (i % 2) * 0.25] for i in range(66)]
+    trav = np.ones((16, 80), dtype=bool)
+    route = fit_route(points, trav=trav, cell=0.25)
+    assert route == [[round(v, 2) for v in p] for p in (points[0], points[-1])]
+    assert line_clear(trav, *route, 0.25)
+
+
+def test_visibility_search_obeys_the_minimum_number_of_required_links():
+    trav = np.ones((10, 10), dtype=bool)
+    trav[:8, 4] = False
+    points = [[1.5, 1.5], [1.5, 8.5], [6.5, 8.5], [6.5, 1.5]]
+    assert fit_visible_route(points, trav, 1, 3) is None
+    assert fit_visible_route(points, trav, 1, 4) == points
+
+
+def test_published_shortcuts_are_watched_for_aftershock_and_length_is_updated(
+    monkeypatch,
+):
+    monkeypatch.setenv("DZ_EXPLORATION_V2", "1")
+    robot = Robot(
+        "R1", "test", "#fff", (0.625, 0.625, 0), (16, 80), 0.25, (0.625, 0.625)
+    )
+    robot.map.grid[:] = FREE
+    cells = [(i + 2, 2 + i % 2) for i in range(66)]
+    monkeypatch.setattr(planning, "astar", lambda *args: cells)
+    goal = ((cells[-1][0] + 0.5) * 0.25, (cells[-1][1] + 0.5) * 0.25)
+    watched, points, length, _ = robot._rescue_route_cells(goal)
+    assert len(points) == 2
+    assert (3, 2) in watched and (3, 2) not in cells
+    assert length == round(math.dist(points[0], points[-1]), 1)
+    robot.routes["S1"] = {
+        "goal": goal,
+        "beacon": None,
+        "cells": watched,
+        "blocked": False,
+    }
+    robot.t = 10
+    robot.map.mark_occupied(3, 2)
+    robot._check_routes()
+    assert robot.routes["S1"]["blocked"]
+    assert any(e["kind"] == "rescue_route_blocked" for e in robot.events)
