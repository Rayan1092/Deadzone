+def fit_visible_route(points, trav, cell, cap):
+    """Fewest visible links in the ordered route; never discard a required bend.
+
+    Breadth-first search guarantees the point cap is met whenever a safe ordered
+    subsequence can meet it. None means the cap cannot represent this route.
+    """
+    if not points or cap < 2:
+        return None
+    parent = {0: None}
+    queue = deque([(0, 1)])
+    while queue:
+        i, count = queue.popleft()
+        if count >= cap:
+            continue
+        for j in range(len(points) - 1, i, -1):
+            if j in parent or not line_clear(trav, points[i], points[j], cell):
+                continue
+            parent[j] = i
+            if j == len(points) - 1:
+                result = [points[j]]
+                while parent[j] is not None:
+                    j = parent[j]
+                    result.append(points[j])
+                return result[::-1]
+            queue.append((j, count + 1))
+    return None
 
 
