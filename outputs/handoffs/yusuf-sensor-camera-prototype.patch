+import { useMemo, useRef } from 'react'
+import { Canvas, useFrame, useThree } from '@react-three/fiber'
+import { Line } from '@react-three/drei'
+import * as THREE from 'three'
+import { useSim } from '../store'
+import Building from './Building'
+import { PersonFigure } from './Actors'
+import { w2t } from './util'
+import { currentFrame, observationLabel, observedHits, projectBox, sensorPose, verticalFov } from './sensorCamera'
+
+function Camera({ robotId, config, boxes }) {
+  const { camera, size } = useThree()
+  const position = useMemo(() => new THREE.Vector3(), [])
+  const target = useMemo(() => new THREE.Vector3(), [])
+  useFrame(() => {
+    const state = useSim.getState()
+    const robot = state.tick?.reality.robots.find((r) => r.id === robotId)
+    const frame = currentFrame(robot, state.time)
+    const pose = sensorPose(frame, config)
+    if (!pose) {
+      for (const el of boxes.current.values()) el.style.display = 'none'
+      return
+    }
+    // Sample pose, lens and boxes update together. No event can steer this camera.
+    camera.fov = verticalFov(config.fov_rad, size.width / size.height)
+    camera.aspect = size.width / size.height
+    camera.updateProjectionMatrix()
+    camera.position.copy(position.fromArray(pose.position))
+    camera.lookAt(target.fromArray(pose.target))
+    camera.updateMatrixWorld()
+    const hits = new Map(observedHits(frame, config).map((hit) => [hit.id, hit]))
+    for (const [id, el] of boxes.current) {
+      const hit = hits.get(id)
+      const rect = hit && projectBox(hit, camera, size.width, size.height)
+      el.style.display = rect ? '' : 'none'
+      if (!rect) continue
+      el.style.transform = `translate(${rect.x}px, ${rect.y}px)`
+      el.style.width = `${rect.width}px`
+      el.style.height = `${rect.height}px`
+    }
+  })
+  return null
+}
+
+function ThermalPerson() {
+  return (
+    <group>
+      <mesh position={[0, .16, 0]} scale={[1.6, .3, .48]}>
+        <sphereGeometry args={[.5, 12, 8]} /><meshBasicMaterial color="#ffe8a3" />
+      </mesh>
+      <mesh position={[.87, .17, 0]}>
+        <sphereGeometry args={[.12, 10, 8]} /><meshBasicMaterial color="#fff7dc" />
+      </mesh>
+    </group>
+  )
+}
+
+function Scene({ robot, frame, config, thermal }) {
+  const fp = useSim((s) => s.floorplan)
+  const hits = observedHits(frame, config)
+  const warm = new Set(hits.map((hit) => hit.id))
+  const people = (fp?.survivors ?? []).filter((p) => !thermal || warm.has(p.id))
+  return (
+    <>
+      <Building thermal={thermal} sensor />
+      {people.map((p) => (
+        <group key={p.id} position={w2t(...p.pos)}>
+          {thermal ? <ThermalPerson /> : <group scale={1 / 1.35}><PersonFigure id={p.id} /></group>}
+        </group>
+      ))}
+      {(fp?.decoys ?? []).filter((p) => !thermal || warm.has(p.id)).map((p) => (
+        <group key={p.id} position={w2t(...p.pos, .3)}>
+          <mesh>
+            <boxGeometry args={[.6, .6, .4]} />
+            {thermal ? <meshBasicMaterial color="#ffb347" /> : <meshStandardMaterial color="#807971" roughness={.6} />}
+          </mesh>
+          {!thermal && Array.from({ length: 6 }, (_, i) => (
+            <mesh key={i} position={[-.25 + i * .1, 0, .22]}>
+              <boxGeometry args={[.035, .5, .045]} /><meshStandardMaterial color="#34383b" />
+            </mesh>
+          ))}
+        </group>
+      ))}
+      {robot?.path?.length > 1 && (
+        <Line points={[w2t(...frame.pose.slice(0, 2), .025), ...robot.path.map((p) => w2t(...p, .025))]}
+              color="#5eead4" lineWidth={1} transparent opacity={.5} />
+      )}
+    </>
+  )
+}
+
+export default function SensorEye({ robotId, config }) {
+  const robot = useSim((s) => s.tick?.reality.robots.find((r) => r.id === robotId))
+  const time = useSim((s) => s.time)
+  const thermal = useSim((s) => s.eyeThermal)
+  const set = useSim((s) => s.set)
+  const frame = currentFrame(robot, time)
+  const hits = observedHits(frame, config)
+  const boxes = useRef(new Map())
+  const evidence = hits.find((hit) => hit.crop && hit.source === 'model')
+  return (
+    <div className={`robot-eye sensor-eye${thermal ? ' thermal' : ''}`}>
+      <div className="eye-head">
+        <i className="swatch" style={{ background: robot?.color }} />
+        <b>{robot?.name ?? robotId} camera</b>
+        <button className={`eye-toggle${thermal ? ' on' : ''}`} onClick={() => set({ eyeThermal: !thermal })}>Thermal</button>
+        <button className="eye-close" aria-label="Close camera" onClick={() => set({ eyeRobot: null })}>×</button>
+      </div>
+      <div className="sensor-viewport">
+        <Canvas dpr={1} camera={{ near: .04, far: 60 }} gl={{ antialias: false, powerPreference: 'low-power' }}>
+          <color attach="background" args={[thermal ? '#030614' : '#171d23']} />
+          <ambientLight intensity={thermal ? .8 : 1.3} />
+          <hemisphereLight args={['#e2e8f0', '#26303d', 1.5]} />
+          {frame && <Scene robot={robot} frame={frame} config={config} thermal={thermal} />}
+          <Camera robotId={robotId} config={config} boxes={boxes} />
+        </Canvas>
+        {hits.map((hit) => (
+          <div key={hit.id} ref={(el) => { if (el) boxes.current.set(hit.id, el); else boxes.current.delete(hit.id) }}
+               className={`eye-box${hit.verdict === 'rejected' ? ' decoy' : ''}`} style={{ display: 'none' }}>
+            <span className="eye-box-label">{observationLabel(hit)}</span>
+          </div>
+        ))}
+        <div className="sensor-hud">
+          <span>{Math.round(config.fov_rad * 180 / Math.PI)}° forward · {config.range_m} m thermal range</span>
+          <span>{frame ? `${frame.t.toFixed(1)} s · ${hits.length ? `${hits.length} observed` : 'no thermal targets'}` : 'Waiting for sensor sample'}</span>
+        </div>
+        {evidence && (
+          <div className="sensor-evidence">
+            <img src={`/crops/${encodeURIComponent(evidence.crop)}`} alt="Thermal crop supplied to the detector" />
+            <span>Classifier input<small>{observationLabel(evidence)}</small></span>
+          </div>
+        )}
+      </div>
+      <span className="sensor-note">Simulated view · boxes mark actual sensor observations</span>
+    </div>
+  )
+}
diff --git a/web/src/three/sensorCamera.js b/web/src/three/sensorCamera.js
new file mode 100644
--- /dev/null
+++ b/web/src/three/sensorCamera.js
@@ -0,0 +1,57 @@
+import * as THREE from 'three'
+
+// Three's perspective fov is vertical; the robot sensor contract is horizontal.
+export function verticalFov(horizontal, aspect) {
+  return THREE.MathUtils.radToDeg(2 * Math.atan(Math.tan(horizontal / 2) / aspect))
+}
+
+export function sensorPose(frame, config) {
+  if (!frame?.pose || !frame.pose.every(Number.isFinite)) return null
+  const [x, y, yaw] = frame.pose
+  return {
+    position: [x, config.height_m, -y],
+    target: [x + Math.cos(yaw), config.height_m, -(y + Math.sin(yaw))],
+  }
+}
+
+export function currentFrame(robot, now) {
+  const frame = robot?.camera
+  // Never carry another robot's view or an older observation through a reset,
+  // replay seek or interrupted stream. Pausing simulation preserves the sample.
+  return frame && now >= frame.t && now - frame.t < .25 ? frame : null
+}
+
+export function observedHits(frame, config) {
+  if (!frame?.pose) return []
+  const [x, y, yaw] = frame.pose
+  return (frame.hits ?? []).filter((hit) => {
+    if (!hit.pos?.every(Number.isFinite)) return false
+    const dx = hit.pos[0] - x, dy = hit.pos[1] - y
+    const angle = Math.atan2(Math.sin(Math.atan2(dy, dx) - yaw), Math.cos(Math.atan2(dy, dx) - yaw))
+    return Math.hypot(dx, dy) <= config.range_m + 1e-6 && Math.abs(angle) <= config.fov_rad / 2 + 1e-6
+  })
+}
+
+export function observationLabel(hit) {
+  if (hit.source !== 'model' || !Number.isFinite(hit.conf)) return 'Hot spot · sim sensor'
+  const verdict = hit.verdict === 'person' ? 'Person' : 'Not a person'
+  return `${verdict} · ${(hit.conf * 100).toFixed(1)}%`
+}
+
+// Boxes mark the sampled object's position; the classifier only scores a crop.
+export function projectBox(hit, camera, width, height) {
+  const center = new THREE.Vector3(hit.pos[0], .3, -hit.pos[1]).applyMatrix4(camera.matrixWorldInverse)
+  if (center.z >= -camera.near) return null
+  let left = Infinity, right = -Infinity, top = -Infinity, bottom = Infinity
+  for (const dx of [-.65, .65]) for (const dy of [0, .65]) for (const dz of [-.4, .4]) {
+    const p = new THREE.Vector3(hit.pos[0] + dx, dy, -hit.pos[1] + dz).project(camera)
+    if (p.z < -1 || p.z > 1) continue
+    left = Math.min(left, p.x); right = Math.max(right, p.x)
+    bottom = Math.min(bottom, p.y); top = Math.max(top, p.y)
+  }
+  if (!Number.isFinite(left) || right < -1 || left > 1 || top < -1 || bottom > 1) return null
+  const clamp = (n) => Math.max(-1, Math.min(1, n))
+  const x = (clamp(left) + 1) * width / 2, y = (1 - clamp(top)) * height / 2
+  return { x, y, width: (clamp(right) - clamp(left)) * width / 2,
+    height: (clamp(top) - clamp(bottom)) * height / 2 }
+}
diff --git a/web/tests/sensor-camera.test.js b/web/tests/sensor-camera.test.js
