+++ b/web/tests/sensor-camera.test.js
@@ -0,0 +1,66 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import * as THREE from 'three'
+import { currentFrame, observationLabel, observedHits, projectBox, sensorPose, verticalFov } from '../src/three/sensorCamera.js'
+
+const config = { enabled: true, range_m: 5, fov_rad: 2 * Math.PI / 3, height_m: .4 }
+const frame = { t: 10, pose: [4, 4, 0], hits: [] }
+
+function cameraFor(sample, aspect = 2) {
+  const camera = new THREE.PerspectiveCamera(verticalFov(config.fov_rad, aspect), aspect, .04, 60)
+  const pose = sensorPose(sample, config)
+  camera.position.fromArray(pose.position)
+  camera.lookAt(new THREE.Vector3(...pose.target))
+  camera.updateMatrixWorld()
+  return camera
+}
+
+test('horizontal sensor cone stays 120 degrees as the viewport resizes', () => {
+  for (const aspect of [.7, 1, 2.5]) {
+    const camera = cameraFor(frame, aspect)
+    for (const degrees of [-61, -59, 0, 59, 61]) {
+      const angle = degrees * Math.PI / 180
+      const point = new THREE.Vector3(4 + 3 * Math.cos(angle), .4, -(4 + 3 * Math.sin(angle))).project(camera)
+      assert.equal(Math.abs(point.x) < 1, Math.abs(degrees) < 60)
+    }
+  }
+})
+
+test('sample yaw determines view in all directions including the wrap boundary', () => {
+  for (const yaw of [0, Math.PI / 2, Math.PI - .01, -Math.PI + .01]) {
+    const camera = cameraFor({ ...frame, pose: [4, 4, yaw] })
+    const direction = camera.getWorldDirection(new THREE.Vector3())
+    assert.ok(Math.abs(direction.x - Math.cos(yaw)) < 1e-10)
+    assert.ok(Math.abs(direction.z + Math.sin(yaw)) < 1e-10)
+  }
+})
+
+test('expired and future samples do not survive replay seek or reset', () => {
+  assert.equal(currentFrame({ camera: frame }, 10), frame)
+  assert.equal(currentFrame({ camera: frame }, 10.1), frame)
+  assert.equal(currentFrame({ camera: frame }, 10.5), null)
+  assert.equal(currentFrame({ camera: frame }, .1), null)
+  assert.equal(currentFrame({}, 10), null)
+})
+
+test('boxes only use current sensor hits inside range and cone', () => {
+  const hit = { id: 'seen', pos: [7, 4] }
+  const sample = { ...frame, hits: [hit, { id: 'behind', pos: [3, 4] }, { id: 'far', pos: [10, 4] }] }
+  assert.deepEqual(observedHits(sample, config), [hit])
+  assert.deepEqual(observedHits({ ...frame, hits: [] }, config), [])
+})
+
+test('projected box disappears when robot faces away from the observation', () => {
+  const hit = { pos: [7, 4] }
+  const rect = projectBox(hit, cameraFor(frame), 520, 300)
+  assert.ok(rect && rect.width > 0 && rect.height > 0)
+  assert.ok(rect.height < 100) // a distant object must not fill the whole viewport
+  assert.equal(projectBox(hit, cameraFor({ ...frame, pose: [4, 4, Math.PI] }), 520, 300), null)
+})
+
+test('sensor fallback is never labelled as model confidence', () => {
+  assert.equal(observationLabel({ source: 'sim', conf: .99, verdict: 'person' }), 'Hot spot · sim sensor')
+  assert.equal(observationLabel({ source: 'model', conf: null }), 'Hot spot · sim sensor')
+  assert.equal(observationLabel({ source: 'model', conf: .963, verdict: 'person' }), 'Person · 96.3%')
+  assert.equal(observationLabel({ source: 'model', conf: .012, verdict: 'rejected' }), 'Not a person · 1.2%')
+})
