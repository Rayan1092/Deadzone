# Copy this file to server/.env only if you want optional services/settings.
# server/.env and its backup/local variants are gitignored. Never put keys in web/.
# Process environment variables take precedence. Restart the server after edits.
# The local simulator and trained detector work without API keys.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Basic settings (commented examples; defaults are shown in the comments).
# DZ_ROBOTS=3                  # Default 1; demo uses 3.
# DZ_SEED=7                    # Default 7; repeatable simulation seed.
# DZ_SPEED=2                   # Default 2; simulation seconds per real second.
# DZ_AUTOSTART=0               # Default paused; set 1 to start immediately.
# DZ_MODE=deadzone             # Default deadzone; baseline stops on lost radio.
# DZ_FLOORPLAN=collapse_01     # Registered building ID or supported JSON path.
# DZ_PUBLIC_URL=https://your-tunnel.example  # Public screen origin, no /phone suffix.

# Optional service models. These are the current implementation defaults.
# GEMINI_MODEL=gemini-3.8-flash
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Per-robot voice IDs are optional; without one, speech falls back to the browser.
# ELEVENLABS_VOICE_R1=
# ELEVENLABS_VOICE_R2=
# ELEVENLABS_VOICE_R3=
# ELEVENLABS_VOICE_R4=
# ELEVENLABS_VOICE_R5=
# ELEVENLABS_VOICE_R6=
# ELEVENLABS_VOICE_R7=
# ELEVENLABS_VOICE_R8=
# ELEVENLABS_VOICE_R9=

# Trained detector is selected automatically; these overrides are normally unset.
# DETECTOR=sim                 # Explicitly use the simulated sensor instead.
# DETECTOR_MODEL=              # Optional model path; default ml/models/detector.pt.

# Every opt-in feature below defaults OFF. Uncomment only the ones you need.
# For the exact rehearsed demo flags/timings use docs/DEMO.md, not this whole list.
# DZ_GEMINI=0                 # Gemini briefing/questions (requires GEMINI_API_KEY).
# DZ_AI_LAB=0                 # Serve Model Lab results and evidence.
# DZ_CONTROL_LEASES=0         # One active controller per robot.
# DZ_VOICE=0                  # Voice/manual robot instructions; also enables control locks.
# DZ_PRESENTER_TOKEN=         # Optional secret operator override; never share publicly.
# DZ_MIC_CHECK=0              # Local microphone diagnostic page.
# DZ_CAMERA_TELEMETRY=0       # Thermal observations delivered through radio reports.
# DZ_PHONE_FRAMES=0           # Linked-only scout camera JPEGs on phones.
# DZ_SENSOR_VIEW=0            # Sampled sensor view in the Reality camera.
# DZ_HEAT_SOURCES=0           # Typed warm objects the thermal detector must classify.
# DZ_COVERAGE_GRID=0          # Predicted radio coverage from Command's known geometry.
# DZ_NETWORK_TRAFFIC=0        # Real bundle hop/hold events and queue depths.
# DZ_FEC=0                    # Error correction on weak radio links.
# DZ_COMPACT_STREAM=0         # Lossless map deltas and capped drawn lidar points.
# DZ_STREAM_OPTIMIZE=0        # Legacy compact stream; leave off with the newer map deltas.
# DZ_OBSTACLES=0              # Solid furniture for motion, lidar and radio.
# DZ_ROBOT_COLLISIONS=0       # Solid robot bodies.
# DZ_SMART_RUBBLE=0           # Operator rubble placement avoids trapping robots.
# DZ_AFTERSHOCK=0             # Operator aftershock controls.
# DZ_SCENARIO_TIMELINE=0      # Optional generated-building disaster schedules.
# DZ_SEARCH_BAYES=0           # Probability-guided frontier selection.
# DZ_EXPLORATION_V2=0         # Alternate room/camera-coverage exploration policy.
# DZ_ZONE_PRIORITY=0          # Head directly toward newly assigned search areas.
# DZ_CRDT=0                   # Optional offline shared-plan editing.
# DZ_RESCUE_ORDER=0           # Rescue-priority guidance from delivered routes.

# These two features default ON. Leave unset for the reference demo.
# DZ_SCENARIO_EVENTS=1        # Building-authored events, including the scripted collapse.
# DZ_GLOBAL_NO_GO=1           # Send exclusions/clears to every robot.
