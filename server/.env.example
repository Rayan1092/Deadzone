# Copy to server/.env (gitignored), add your own key, then restart the backend.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Opt in only for a dry run; default behavior remains the Version 1 local briefing.
DZ_GEMINI=1
# Optional override; default verified against Google's API docs on 2026-11-07.
GEMINI_MODEL=gemini-3.8-flash
# Opt-in room-entry / camera-coverage planner; dry-run before the fixed demo.
DZ_EXPLORATION_V2=0
# Reconstruct the robot's actual sampled sensor view on the screen only.
DZ_SENSOR_VIEW=0
# Delivered camera observations for Command/phone; default off until a dry run.
DZ_CAMERA_TELEMETRY=0
# Lossless negotiated /ws/screen map deltas; preserves all 36 drawn lidar endpoints.
DZ_COMPACT_STREAM=0
# Predicted RSSI from Command's known geometry and delivered relay reports only.
DZ_COVERAGE_GRID=0
# Local-only record/playback diagnostic can be enabled without control leases.
DZ_MIC_CHECK=0
# Registered map ID or repo-relative JSON path; blank keeps collapse_01.
DZ_FLOORPLAN=
# Allows explicit reset controls to play generated disaster scripts; never auto-starts.
DZ_SCENARIO_TIMELINE=0
